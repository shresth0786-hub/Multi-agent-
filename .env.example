# Provider selection: groq | gemini | ollama | openai (auto-detects if blank)
LLM_PROVIDER=groq
EMBEDDING_PROVIDER=huggingface

# --- Free options (recommended) ---
# Groq: free 14k req/day at https://console.groq.com/keys
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.1-8b-instant

# Gemini: free 1500 req/day at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIza...
GEMINI_MODEL=gemini-1.5-flash

# Ollama: fully local, no key, requires `ollama serve` + `ollama pull llama3.1`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_EMBED_MODEL=nomic-embed-text

# HuggingFace local embeddings (free, no key, ~80MB download first run)
HF_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_CACHE_DIR=
CHROMA_PERSIST_DIR=./chroma_db

# --- Paid fallback ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.2
