# ---- LLM (OpenAI default) ----
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LLM_TEMPERATURE=0.2

# ---- Research ----
TAVILY_API_KEY=tvly-...
ENABLE_WEB_SEARCH=true
WEB_SEARCH_MAX_RESULTS=5
RESEARCH_COVERAGE_THRESHOLD=0.6
MAX_RESEARCH_DEPTH=2

# ---- Vectorstore (FAISS) ----
DATA_DIR=data/raw_docs
INDEX_DIR=data/faiss_index
VECTORSTORE_TOP_K=5

# ---- Sandboxed analyst ----
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_MAX_OUTPUT_BYTES=200000

# ---- State & durability ----
TASK_DB_PATH=data/tasks.sqlite
CHECKPOINT_DIR=data/checkpoints
WORKER_COUNT=2
TASK_TIMEOUT_SECONDS=300

# ---- Writer / Critiquer loop ----
MAX_CRITIQUE_ITERATIONS=3
CRITIQUE_THRESHOLD=0.85
REPORT_MAX_WORDS=2500

# ---- App ----
APP_NAME=multi-agent-research
API_PREFIX=/api/v1
# ---- LLM provider: openai | gemini ----
LLM_PROVIDER=openai

# ---- LLM (Gemini optional) ----
GEMINI_API_KEY=
# NOTE: Google's free tier allows 20 requests/day PER MODEL. Switch models (or upgrade) if you hit 429.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
# Free tier: 5 requests/minute and 20/day per model. Throttle paces calls; set 0 to disable.
GEMINI_MIN_REQUEST_INTERVAL_SECONDS=15
LLM_MAX_RETRIES=1

# ---- Chat UX ----
MAX_CONVERSATION_TURNS=8
QUICK_ANSWER_MAX_WORDS=200
