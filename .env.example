# Provider selection: groq | gemini | ollama | openai (auto-detects if blank)
LLM_PROVIDER=groq
EMBEDDING_PROVIDER=huggingface

# --- Free options (recommended) ---
# Groq: free 14k req/day at https://console.groq.com/keys
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.1-8b-instant

# Gemini: free 1500 req/day at https://aistudio.google.com/app/apikey
# NOTE: Google's free tier allows 20 requests/day PER MODEL. Switch models if you hit 429.
GOOGLE_API_KEY=AIza...
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
GEMINI_MIN_REQUEST_INTERVAL_SECONDS=15

# Ollama: fully local, no key, requires `ollama serve` + `ollama pull llama3.1`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_EMBED_MODEL=nomic-embed-text

# HuggingFace local embeddings (free, no key, ~80MB download first run)
HF_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_CACHE_DIR=
CHROMA_PERSIST_DIR=./chroma_db

# ---- LLM (OpenAI paid fallback) ----
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2000
LLM_MAX_RETRIES=1

# ---- Research ----
TAVILY_API_KEY=tvly-...
ENABLE_WEB_SEARCH=true
WEB_SEARCH_MAX_RESULTS=5
RESEARCH_COVERAGE_THRESHOLD=0.6
MAX_RESEARCH_DEPTH=2

# ---- Vectorstore (FAISS) ----
DATA_DIR=data/raw_docs
INDEX_DIR=data/faiss_index
VECTORSTORE_TOP_K=5

# ---- Sandboxed analyst ----
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_MAX_OUTPUT_BYTES=200000

# ---- State & durability ----
TASK_DB_PATH=data/tasks.sqlite
CHECKPOINT_DIR=data/checkpoints
WORKER_COUNT=2
TASK_TIMEOUT_SECONDS=300

# ---- Writer / Critiquer loop ----
MAX_CRITIQUE_ITERATIONS=3
CRITIQUE_THRESHOLD=0.85
REPORT_MAX_WORDS=2500

# ---- App ----
APP_NAME=multi-agent-research
API_PREFIX=/api/v1

# ---- Chat UX ----
MAX_CONVERSATION_TURNS=8
QUICK_ANSWER_MAX_WORDS=200
